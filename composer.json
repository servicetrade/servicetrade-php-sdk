{
    "name": "servicetrade/servicetrade",
    "description": "Official PHP SDK for the ServiceTrade API",
    "type": "library",
    "license": "MIT",
    "keywords": ["servicetrade", "api", "sdk", "oauth2"],
    "homepage": "https://github.com/servicetrade/servicetrade-php-sdk",
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "ServiceTrade\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ServiceTrade\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
